# The production field pilot uses the bundled public/data/ads.json by default.
# Set PUBLIC_ADS_MODE=off to disable it at build time; development defaults to off.
# Modes: off, local (bundled JSON), remote (HTTPS feed; localhost HTTP for testing).
PUBLIC_ADS_MODE=off
PUBLIC_ADS_FEED_URL=
# Independent Admin gateway: public legacy anon JWT only, never service_role/secret.
PUBLIC_ADS_API_KEY=
PUBLIC_ADS_EVENTS_URL=

# Public passenger beta stays separate from the paused private account pilot.
PUBLIC_PASSENGER_MODE=guest
# Owner-confirmed public support/privacy contact. Never use a private address by default.
PUBLIC_SUPPORT_EMAIL=

# Accounts fail closed when configuration is missing. No local/fake login switch.
# Use only the project's URL and publishable key (NOT service_role / sb_secret_*).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
