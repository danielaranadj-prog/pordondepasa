# The production field pilot uses the bundled public/data/ads.json by default.
# Set PUBLIC_ADS_MODE=off to disable it at build time; development defaults to off.
# Modes: off, local (bundled JSON), remote (HTTPS feed; localhost HTTP for testing).
PUBLIC_ADS_MODE=off
PUBLIC_ADS_FEED_URL=
# Public gateway JWT only. Never put secret/service_role credentials here.
PUBLIC_ADS_API_KEY=
PUBLIC_ADS_EVENTS_URL=
